library(tidyverse)
library(lubridate)
set.seed(123)

# Parámetros
sectores <- 1:5
fechas <- seq.Date(as.Date("2020-01-01"), as.Date("2025-11-1"), by = "day")

# Características de cada zona
zonas <- tibble(
  sector_id = sectores,
  pendiente = runif(5, 3, 15),
  porcentaje_impermeable = sample(20:80, 5),
  uso_suelo = sample(c("Urbano","Residencial","Industrial","Rural"), 5, replace = TRUE),
  umbral_inundacion_m = runif(5, 1.0, 1.6)
)

# Función para simular nivel de agua
simular_nivel_agua <- function(precipitacion, imp, pendiente) {
  base <- precipitacion * (imp / 100) * 0.015
  efecto_pendiente <- max(0.3, 2 / pendiente)
  ruido <- rnorm(1, 0, 0.05)
  return(base * efecto_pendiente + ruido)
}

# Crear dataset completo
dataset <- expand_grid(
  fecha = fechas,
  sector_id = sectores
) %>%
  left_join(zonas, by="sector_id") %>%
  mutate(
    precipitacion_mm = rgamma(n(), shape=2, scale=5),
    nivel_agua_m = pmax(
      0,
      mapply(simular_nivel_agua, precipitacion_mm, porcentaje_impermeable, pendiente)
    )
  )


# 1. HISTOGRAMA DE PRECIPITACIÓN PROMEDIO POR AÑO--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

precipitacion_por_anio <- dataset %>%
  mutate(anio = year(fecha)) %>%
  group_by(anio) %>%
  summarise(precipitacion_promedio = mean(precipitacion_mm))

ggplot(precipitacion_por_anio, aes(x = as.factor(anio), y = precipitacion_promedio)) +
  geom_col(fill = "skyblue", color = "black") +
  labs(
    title = "Precipitación promedio por año",
    x = "Año",
    y = "Precipitación promedio (mm)"
  ) +
  theme_minimal()


# 2. HISTOGRAMA DE PRECIPITACIÓN PROMEDIO POR MES-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

precipitacion_por_mes <- dataset %>%
  mutate(
    anio = year(fecha),
    mes = month(fecha, label = TRUE, abbr = TRUE)
  ) %>%
  group_by(mes) %>%
  summarise(precipitacion_promedio = mean(precipitacion_mm))

ggplot(precipitacion_por_mes, aes(x = mes, y = precipitacion_promedio)) +
  geom_col(fill = "steelblue", color = "black") +
  labs(
    title = "Promedio de precipitación por mes (2020–2025)",
    x = "Mes",
    y = "Precipitación promedio (mm)"
  ) +
  theme_minimal()


# 3. HISTOGRAMA DEL NIVEL DE AGUA PROMEDIO POR AÑO-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

nivel_por_anio <- dataset %>%
  mutate(anio = year(fecha)) %>%
  group_by(anio) %>%
  summarise(nivel_promedio = mean(nivel_agua_m))

ggplot(nivel_por_anio, aes(x = as.factor(anio), y = nivel_promedio)) +
  geom_col(fill = "lightgreen", color = "black") +
  labs(
    title = "Nivel de agua promedio por año",
    x = "Año",
    y = "Nivel promedio del agua (m)"
  ) +
  theme_minimal()

# 4. HISTOGRAMA DEL NIVEL DE AGUA PROMEDIO POR MES-----------------------------------------------------------------------------------------------------------------------------------------------------------------------

nivel_por_mes <- dataset %>%
  mutate(mes = month(fecha, label = TRUE, abbr = TRUE)) %>%
