

library(tidyverse)
library(lubridate)
set.seed(123)

# Parámetros
sectors <- 1:5
dates <- seq.Date(as.Date("2020-01-01"), as.Date("2025-11-1"), by = "day")

# Características de cada zona
zones <- tibble(
  sector_id = sectors,
  slope = runif(5, 3, 15),
  impervious_pct = sample(20:80, 5),
  land_use = sample(c("Urbano","Residencial","Industrial","Rural"), 5, replace = TRUE),
  flood_threshold_m = runif(5, 1.0, 1.6)
)

# Función para simular nivel de agua
simulate_water_level <- function(precip, imp, slope) {
  base <- precip * (imp / 100) * 0.015
  slope_effect <- max(0.3, 2 / slope)
  noise <- rnorm(1, 0, 0.05)
  return(base * slope_effect + noise)
}

# Crear dataset completo
dataset <- expand_grid(
  date = dates,
  sector_id = sectors
) %>%
  left_join(zones, by="sector_id") %>%
  mutate(
    precip_mm = rgamma(n(), shape=2, scale=5),
    water_level_m = pmax(
      0,
      mapply(simulate_water_level, precip_mm, impervious_pct, slope)
    )
  )


# 1. HISTOGRAMA DE PRECIPITACIÓN PROMEDIO POR AÑO--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------


precip_por_anio <- dataset %>%
  mutate(anio = year(date)) %>%
  group_by(anio) %>%
  summarise(precipitacion_promedio = mean(precip_mm))

ggplot(precip_por_anio, aes(x = as.factor(anio), y = precipitacion_promedio)) +
  geom_col(fill = "skyblue", color = "black") +
  labs(
    title = "Precipitación promedio por año",
    x = "Año",
    y = "Precipitación promedio (mm)"
  ) +
  theme_minimal()


# 2. HISTOGRAMA DE PRECIPITACIÓN PROMEDIO POR MES-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------


precip_por_mes <- dataset %>%
  mutate(
    anio = year(date),
    mes = month(date, label = TRUE, abbr = TRUE)
  ) %>%
  group_by(mes) %>%
  summarise(precipitacion_promedio = mean(precip_mm))

ggplot(precip_por_mes, aes(x = mes, y = precipitacion_promedio)) +
  geom_col(fill = "steelblue", color = "black") +
  labs(
    title = "Promedio de precipitación por mes (2020–2022)",
    x = "Mes",
    y = "Precipitación promedio (mm)"
  ) +
  theme_minimal()


