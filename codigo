library(tidyverse)
library(lubridate)
library(e1071)
set.seed(123)

# 1. Generar dataset ------------------------------------------------------------------------------

sectores <- 1:5
fechas <- seq.Date(as.Date("2020-01-01"), as.Date("2025-11-01"), by = "day")

zonas <- tibble(
  sector_id = sectores,
  pendiente = runif(5, 3, 15),
  porcentaje_impermeable = sample(20:80, 5),
  uso_suelo = sample(c("Urbano","Residencial","Industrial","Rural"), 5, replace = TRUE),
  umbral_inundacion_m = runif(5, 1.0, 1.6)
)

simular_nivel_agua <- function(precipitacion, imp, pendiente) {
  base <- precipitacion * (imp / 100) * 0.015
  efecto_pendiente <- max(0.3, 2 / pendiente)
  ruido <- rnorm(1, 0, 0.05)
  return(base * efecto_pendiente + ruido)
}

dataset <- expand_grid(
  fecha = fechas,
  sector_id = sectores
) %>%
  left_join(zonas, by="sector_id") %>%
  mutate(
    precipitacion_mm = rgamma(n(), shape=2, scale=5),
    nivel_agua_m = pmax(0, mapply(simular_nivel_agua, precipitacion_mm, porcentaje_impermeable, pendiente))
  )

# 2. Ajuste dinámico del umbral para generar la variable objetivo
umbral_factor <- 0.7

repeat {
  dataset <- dataset %>%
    mutate(
      umbral_adj = umbral_inundacion_m * umbral_factor,
      riesgo_inundacion = if_else(nivel_agua_m >= umbral_adj, "Inunda", "No_inunda")
    )
  
  tabla <- table(dataset$riesgo_inundacion)
  porcentaje_inunda <- tabla["Inunda"] / sum(tabla)
  
  if (!is.na(porcentaje_inunda) && porcentaje_inunda > 0.05) break
  
  umbral_factor <- umbral_factor * 0.9
}

dataset$riesgo_inundacion <- as.factor(dataset$riesgo_inundacion)

print(table(dataset$riesgo_inundacion)) # verificar distribución

# 3. Selección de variables para Bayes incluyendo sector_id --------------------------------------

datos_bayes <- dataset %>%
  select(
    sector_id,
    riesgo_inundacion,
    precipitacion_mm,
    pendiente,
    porcentaje_impermeable,
    nivel_agua_m
  )

# 4. División entrenamiento/prueba -----------------------------------------------------------------

set.seed(456)
n <- nrow(datos_bayes)
idx_train <- sample(1:n, size = 0.7 * n)

train <- datos_bayes[idx_train, ]
test  <- datos_bayes[-idx_train, ]

# 5. Entrenamiento modelo Bayes -------------------------------------------------------------------

modelo_bayes <- naiveBayes(
  riesgo_inundacion ~ precipitacion_mm + pendiente + porcentaje_impermeable + nivel_agua_m,
  data = train
)

# 6. Predicciones y agregar al dataset ------------------------------------------------------------

pred <- predict(modelo_bayes, test)

test_pred <- test %>%
  mutate(riesgo_predicho = pred)

# 7. Gráfica: Proporción de riesgo por sector ----------------------------------------------------

ggplot(test_pred, aes(x = factor(sector_id), fill = riesgo_predicho)) +
  geom_bar(position = "fill") +
  scale_fill_manual(values = c("No_inunda" = "skyblue", "Inunda" = "red")) +
  labs(
    title = "Proporción de riesgo de inundación por sector",
    x = "Sector",
    y = "Proporción",
    fill = "Riesgo predicho"
  ) +
  theme_minimal()

# 8. Scatter plot: precipitación vs nivel de agua -------------------------------------------------

ggplot(test_pred, aes(x = precipitacion_mm, y = nivel_agua_m, color = riesgo_predicho)) +
  geom_point(alpha = 0.6) +
  scale_color_manual(values = c("No_inunda" = "skyblue", "Inunda" = "red")) +
  labs(
    title = "Riesgo de inundación según precipitación y nivel de agua",
    x = "Precipitación (mm)",
    y = "Nivel de agua (m)",
    color = "Riesgo predicho"
  ) +
  theme_minimal()



